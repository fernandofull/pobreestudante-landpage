# Merge BEFORE existing Python/Passenger/LSAPI routing in the document root.
# Direct TLS termination only. See diagnostics/RELATORIO.md for proxy hosting.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^pobreestudante\.com\.br$ [NC]
RewriteRule ^ https://pobreestudante.com.br%{REQUEST_URI} [R=308,L,NE]
